{
    "name": "bible_display",
    "title": "圣经显示",
    "type": "object",
    "properties": {
        "language": {
            "title": "圣经语言",
            "type": "string",
            "enum": ["中文", "English", "对照"],
            "default": "中文"
        },
        "chinese": {
            "title": "中文圣经版本",
            "type": "string",
            "enum": ["简体", "繁體"],
            "default": "简体"
        },
        "english": {
            "title": "英文圣经版本",
            "type": "string",
            "enum": ["KJV", "ASV", "WEB"],
            "default": "ASV"
        },
        "zoom": {
            "title": "字体大小(%)",
            "type": "integer",
            "default": 100
        },
        "range_location": {
            "title": "经节范围注释位置",
            "type": "string",
            "enum": ["开头", "结尾"],
            "default": "开头"
        },
        "note_position": {
            "title": "笔记位置",
            "description": "",
            "enum": ["开头", "结尾", "不显示"],
            "default": "开头"
        },
        "note_display": {
            "title": "笔记显示模式",
            "type": "string",
            "enum": ["范围", "范围和笔记", "经文和笔记", "打印"],
            "default": "范围和笔记"
        },
        "display_type": {
            "title": "投影显示模式",
            "type": "string",
            "enum": ["经节", "整章"],
            "default": "经节"
        },
        "chapter_theme": {
            "title": "整章模式字体颜色",
            "type": "string",
            "enum": ["默认", "红蓝"],
            "default": "默认"
        },
        "menu_to_projector": {
            "title": "从圣经目录直接投影",
            "type": "boolean",
            "default": false
        }
    }
}
